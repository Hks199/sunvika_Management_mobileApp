      "bundleIdentifier": "com.sunvika.management"
    },
    "android": {
      "package": "com.sunvika.management",
      "usesCleartextTraffic": true
    },
    "plugins": [
      "expo-secure-store",
      "expo-asset",
      "expo-status-bar",
      "expo-sharing",
      "expo-notifications"
    ]
  }
}
